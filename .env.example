# Local dev defaults: frontend uses Vite proxy (/api -> local backend)
# Keep empty to use default proxy target http://127.0.0.1:3100
VITE_LOCAL_API_PROXY_TARGET=http://127.0.0.1:3100

# Optional: force a remote API base URL, e.g. for shared testing
# VITE_WORKBENCH_API_BASE_URL=https://workbench-tenant-server-production.up.railway.app/api
